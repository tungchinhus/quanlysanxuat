rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'super_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isManager() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'manager' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isTotruong() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'totruong' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isQuandaycao() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'quandaycao' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isBoidaycao() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'boidaycao' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isQuandayha() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'quandayha' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isBoidayha() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'boidayha' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isKcs() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             'kcs' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles != null &&
             role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Rules cho collection xeDuaDon
    match /xeDuaDon/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager() || isTotruong());
    }
    
    // Rules cho collection lichTrinhXe
    match /lichTrinhXe/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection chiTietTuyenDuong
    match /chiTietTuyenDuong/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection dangKyPhanXe
    match /dangKyPhanXe/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection routeDetails (backup)
    match /routeDetails/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection registrations
    match /registrations/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection nhanVien
    match /nhanVien/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // Rules cho collection users (quản lý người dùng)
    match /users/{userId} {
      // Allow authenticated users to read all users (needed for login matching)
      allow read: if isAuthenticated();
      // Only admins can create users
      allow create: if isAdmin() || isSuperAdmin();
      // Users can update their own data, admins can update any user
      allow update: if isOwner(userId) || isAdmin() || isSuperAdmin();
      // Only super admins can delete users
      allow delete: if isSuperAdmin();
    }
    
    // Rules cho collection roles (quản lý vai trò)
    match /roles/{roleId} {
      // Allow public read access for roles (needed for login)
      allow read: if true;
      // Only super admins can create, update, or delete roles
      allow write: if isSuperAdmin();
    }
    
    // Rules cho collection permissions (quản lý quyền)
    match /permissions/{permissionId} {
      // Allow public read access for permissions (needed for login)
      allow read: if true;
      // Only super admins can create, update, or delete permissions
      allow write: if isSuperAdmin();
    }
    
    // Rules cho collection userRoles (liên kết người dùng-vai trò)
    match /userRoles/{userRoleId} {
      // Users can read their own role assignments
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || isAdmin() || isSuperAdmin());
      // Only admins can create, update, or delete role assignments
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Rules cho collection userPermissions (liên kết người dùng-quyền)
    match /userPermissions/{userPermissionId} {
      // Users can read their own permission assignments
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.userId) || isAdmin() || isSuperAdmin());
      // Only admins can create, update, or delete permission assignments
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Rules cho collection bangve (bảng vẽ) - SIMPLIFIED FOR TESTING
    match /bangve/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Tạm thời cho phép tất cả authenticated users
    }

    // Rules cho collection drawings (bảng vẽ - alternative collection) - SIMPLIFIED FOR TESTING
    match /drawings/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Tạm thời cho phép tất cả authenticated users
    }

    // Rules cho collection user_bangve (gán bảng vẽ cho user) - SIMPLIFIED FOR TESTING
    match /user_bangve/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Tạm thời cho phép tất cả authenticated users
    }

    // Rules cho collection tbl_bd_ha (bối dây hạ) - TEMPORARILY OPEN FOR TESTING
    match /tbl_bd_ha/{document} {
      allow read: if true; // Temporarily allow public read for testing
      allow write: if true; // Temporarily allow public write for testing
    }

    // Rules cho collection tbl_bd_cao (bối dây cao) - TEMPORARILY OPEN FOR TESTING
    match /tbl_bd_cao/{document} {
      allow read: if true; // Temporarily allow public read for testing
      allow write: if true; // Temporarily allow public write for testing
    }

    // Rules cho collection tbl_bd_ep (bối dây ép) - TEMPORARILY OPEN FOR TESTING
    match /tbl_bd_ep/{document} {
      allow read: if true; // Temporarily allow public read for testing
      allow write: if true; // Temporarily allow public write for testing
    }

    // Rules cho collection tbl_ep_boiday (ép bối dây)
    match /tbl_ep_boiday/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Tạm thời cho phép tất cả authenticated users
    }

    // Rules cho collection kcs_approve (KCS approval records)
    // TEMPORARY RELAXED: allow all authenticated users to read/create/update to unblock UI
    // NOTE: Tighten this back to role-based checks (isKcs/isAdmin/...) once user roles are synced in Firestore
    match /kcs_approve/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }
    
    // Temporary rule for testing - allow all authenticated users to create KCS approvals
    // This should be removed once proper KCS users are set up
    match /kcs_approve_test/{document} {
      allow read, write: if isAuthenticated();
    }
  }
}
